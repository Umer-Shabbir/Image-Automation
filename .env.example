# ==============================================================================
# Image Automation — Environment Configuration (.env)
# Copy this file to '.env' and adjust settings to match your machine setup.
# ==============================================================================

# ── Target Platform URLs ──────────────────────────────────────────────────────
# URL for Google Flow (image / video studio)
FLOW_URL=https://flow.google.com

# URL for Gemini Canvas Bulk Media Generator
BULK_APP_URL=https://gemini.google.com/share/79e5de5150e6

# ── Local Storage & Persistence Paths ─────────────────────────────────────────
# SQLite database file path (relative to project root or absolute)
DB_PATH=gpt_batch.db

# Directory where generated media (images / videos) and project outputs are saved
OUTPUT_DIR=output

# Directory where persistent browser user-data profiles are stored
PROFILES_DIR=profiles

# Logging configuration
LOG_DIR=logs
LOG_FILE=logs/app.log

# ── Presets & Styles (Optional) ───────────────────────────────────────────────
# Optional custom path to master_presets_registry.json if stored outside project
# PRESETS_REGISTRY_PATH=

# ── External Browser Executable (Optional) ────────────────────────────────────
# By default, Playwright uses its managed Chromium browser.
# If you prefer using a system-installed Google Chrome, Brave, or Edge, specify its path:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=/usr/bin/google-chrome

# ── AI Validation & Quality Control (Optional) ────────────────────────────────
# Anthropic API key used by validator.py (for automated Claude Vision checks)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# VALIDATION_MODEL=claude-3-haiku-20240307
